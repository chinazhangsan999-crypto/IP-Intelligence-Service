{
  "name": "ip-intelligence-service",
  "version": "0.1.0",
  "private": true,
  "description": "Centralized IP intelligence service for navigation sites.",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/app.js",
    "dev": "node --env-file=.env --watch src/app.js",
    "test": "node --test",
    "data:update-open": "node --env-file=.env scripts/update-open-data.js",
    "data:update-dbip": "node --env-file=.env scripts/update-dbip-data.js",
    "data:update-ip2proxy": "node --env-file=.env scripts/update-ip2proxy-data.js",
    "data:update-sapics": "node --env-file=.env scripts/update-sapics-data.js",
    "data:update-all": "node --env-file=.env scripts/update-dbip-data.js && node --env-file=.env scripts/update-open-data.js && node --env-file=.env scripts/update-ip2proxy-data.js",
    "db:migrate": "node --env-file=.env src/database/migrate.js",
    "client:admin": "node --env-file=.env src/database/clientAdmin.js",
    "admin:account": "node --env-file=.env src/database/adminAccount.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ip2proxy-nodejs": "^4.5.0",
    "ipaddr.js": "^2.5.0",
    "maxmind": "^5.0.7",
    "pg": "^8.23.0",
    "yauzl": "^2.10.0"
  }
}

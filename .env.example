# Service
NODE_ENV=production
PORT=3101
HOST=127.0.0.1
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

# Data directories
IP_DATA_DIR=./data
IP_CONFIG_DIR=./config
DBIP_CITY_MMDB_FILE=dbip-city-lite.mmdb
DBIP_ASN_MMDB_FILE=dbip-asn-lite.mmdb
CLOUD_RANGES_FILE=cloud-ranges.json
# Authorized evidence sources. Azure Public/China resolve their current official URLs automatically.
CAIDA_AUA_ACCEPTED=0
PEERINGDB_AUP_ACCEPTED=0
# Internal-only Routinator HTTP endpoint. Never expose its HTTP/RTR ports publicly.
# ROUTINATOR_URL=http://routinator:8323/json
TOR_EXIT_LIST_FILE=tor-exit-nodes.txt
IP2PROXY_BIN_FILE=IP2PROXY-LITE.BIN
IP2PROXY_AUTO_UPDATE_ENABLED=0
SAPICS_AUTO_UPDATE_ENABLED=0
SAPICS_UPDATE_HOUR_BJT=8
# IP2PROXY_DOWNLOAD_TOKEN=<download token kept only on the server>
# IP2PROXY_DOWNLOAD_CODE=PX12LITEBIN
IP2PROXY_UPDATE_INTERVAL_DAYS=7
ASN_CLASSIFICATION_FILE=asn-classification.json
MMDB_CACHE_SIZE=10000
IP_DATA_AUTO_UPDATE_ENABLED=1
IP_DATA_UPDATE_INTERVAL_HOURS=6
IP_DATA_UPDATE_STARTUP_DELAY_SECONDS=60

# Authentication (generate a distinct secret per navigation site)
HMAC_MAX_CLOCK_SKEW_SECONDS=60
NONCE_TTL_SECONDS=300
NONCE_MAX_ENTRIES=100000
MAX_REQUEST_BODY_BYTES=32768
HTTP_REQUEST_TIMEOUT_MS=10000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000

# Prometheus scraping only. The browser admin console uses its own account and password.
METRICS_ENABLED=0
# METRICS_TOKEN=<random token for Prometheus scraping>
SLOW_REQUEST_THRESHOLD_MS=1000

# Public single-IP lookup page and endpoint.
PUBLIC_LOOKUP_ENABLED=1
PUBLIC_LOOKUP_RATE_LIMIT_PER_MINUTE=30
# Enable only when the service is behind a trusted reverse proxy that overwrites X-Forwarded-For.
PUBLIC_TRUST_PROXY=0

# PostgreSQL management data. Generate the master key with 32 random bytes
# encoded as 64 hexadecimal characters. Never commit real values.
# DATABASE_URL=postgresql://ip_service:password@127.0.0.1:5432/ip_intelligence
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
# CLIENT_SECRET_MASTER_KEY=<64 hexadecimal characters>

# Redis remains optional until the central service runs multiple instances.
# REDIS_URL=
